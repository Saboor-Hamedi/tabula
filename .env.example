# Browser-only mode (default): the user supplies their own key in Settings.
# VITE_API_MODE=local

# Public/server mode: the browser sends model calls through /api/deepseek.
VITE_API_MODE=proxy
DEEPSEEK_API_KEY=
PORT=8787
RATE_LIMIT_PER_MINUTE=30

# Optional opt-in error reporting endpoint.
# VITE_TELEMETRY_ENDPOINT=

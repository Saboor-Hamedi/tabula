# Tabula Environment Configuration
# Copy this file to .env and fill in your values.
# .env is ignored by git and will never be committed.

# Supabase Public Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Server-Only Admin Key (NEVER prefix with VITE_)
# Allows the backend proxy to read the encrypted platform key from `user_api_keys`,
# verify 7-day trials / Stripe subscriptions, check monthly token quotas, and write to `usage_ledger`.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional dedicated secret for encrypting the platform API key at rest in `user_api_keys`.
# If omitted, the server derives an encryption key from SUPABASE_SERVICE_ROLE_KEY.
API_KEY_ENCRYPTION_SECRET=

# Optional monthly token allowances per plan tier
MONTHLY_TOKENS_FREE=250000
MONTHLY_TOKENS_PRO=5000000

# Stripe Billing (server-only — NEVER prefix with VITE_)
STRIPE_SECRET_KEY=sk_live_or_test_your_stripe_secret_key
STRIPE_PRICE_ID_PRO_MONTHLY=price_your_monthly_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Set to 'true' only when running behind a trusted reverse proxy (Nginx, Cloudflare, etc.)
TRUST_PROXY=false

{
  "rewrites": [
    {
      "source": "/posts/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(whatsapp|facebookexternalhit|facebot|instagram|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|pinterest|embedly|vkshare|w3c_validator).*"
        }
      ],
      "destination": "/api/post-og?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
